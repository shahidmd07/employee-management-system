<section class="auth">
    <div class="auth-brand">
        <div class="people">EMS</div>
        <h1>Employee Registration</h1>
        <p>Register using the Employee ID created by your administrator.</p>
    </div>
    <div class="auth-form">
        <h2>Create Employee Account</h2>
        <form method="post" action="/employee/register">
            <label>Employee ID<input name="employeeId" required></label>
            <label>Username<input name="username" required minlength="3"></label>
            <label>Password<input type="password" name="password" required minlength="8"></label>
            <label>Confirm Password<input type="password" name="confirmPassword" required></label>
            <button type="submit">Register</button>
        </form>
        <small><a href="/login">Back to Login</a></small>
    </div>
</section>
