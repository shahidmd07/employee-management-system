<section class="panel">
    <h2>Leave Request Tracking</h2>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Leave Type</th><th>From</th><th>To</th><th>Reason</th><th>Status</th><th>Action</th></tr></thead>
            <tbody>
                <% leaves.forEach(leave => { %>
                    <tr>
                        <td><%= leave.leave_type %></td>
                        <td><%= leave.from_date %></td>
                        <td><%= leave.to_date %></td>
                        <td><%= leave.reason %></td>
                        <td class="<%= leave.status.toLowerCase() %>"><%= leave.status %></td>
                        <td>
                            <% if (leave.status === 'Pending') { %>
                                <form method="post" action="/employee/leaves/<%= leave.id %>/cancel" onsubmit="return confirm('Cancel this leave request?')">
                                    <button class="danger" type="submit">Cancel</button>
                                </form>
                            <% } else { %>—<% } %>
                        </td>
                    </tr>
                <% }) %>
                <% if (!leaves.length) { %><tr><td colspan="6">No leave requests found.</td></tr><% } %>
            </tbody>
        </table>
    </div>
</section>
