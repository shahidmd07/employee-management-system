<section class="panel">
    <h2>My Details</h2>
    <div class="details">
        <div><small>Employee ID</small><b><%= employee.employee_id %></b></div>
        <div><small>Full Name</small><b><%= employee.full_name %></b></div>
        <div><small>Email</small><b><%= employee.email %></b></div>
        <div><small>Phone</small><b><%= employee.phone %></b></div>
        <div><small>Date of Birth</small><b><%= employee.date_of_birth %></b></div>
        <div><small>Department</small><b><%= employee.department %></b></div>
        <div><small>Designation</small><b><%= employee.designation %></b></div>
        <div><small>Salary</small><b><%= employee.salary %></b></div>
        <div><small>Address</small><b><%= employee.address %></b></div>
    </div>
</section>
