<section class="panel">
    <h2>Today's Attendance</h2>
    <% if (!today || !today.check_in) { %>
        <form method="post" action="/employee/attendance/check-in">
            <button type="submit">Check In</button>
        </form>
    <% } else if (!today.check_out) { %>
        <p>Check In: <b><%= today.check_in %></b></p>
        <form method="post" action="/employee/attendance/check-out">
            <button type="submit">Check Out</button>
        </form>
    <% } else { %>
        <p>Check In: <b><%= today.check_in %></b></p>
        <p>Check Out: <b><%= today.check_out %></b></p>
        <p>Status: <b>Present</b></p>
    <% } %>
</section>

<section class="panel">
    <div class="between">
        <h2>Attendance History</h2>
        <form method="get" action="/employee/attendance">
            <input type="month" name="month" value="<%= month %>">
            <button type="submit">View</button>
        </form>
    </div>
    <div class="stats three">
        <div class="stat"><small>Total Records</small><strong><%= summary.total_days || 0 %></strong></div>
        <div class="stat"><small>Present</small><strong><%= summary.present_days || 0 %></strong></div>
        <div class="stat"><small>Incomplete</small><strong><%= summary.incomplete_days || 0 %></strong></div>
    </div>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Date</th><th>Check In</th><th>Check Out</th><th>Status</th></tr></thead>
            <tbody>
                <% records.forEach(record => { %>
                    <tr>
                        <td><%= record.attendance_date %></td>
                        <td><%= record.check_in || '—' %></td>
                        <td><%= record.check_out || '—' %></td>
                        <td><%= record.status %></td>
                    </tr>
                <% }) %>
                <% if (!records.length) { %><tr><td colspan="4">No attendance records for this month.</td></tr><% } %>
            </tbody>
        </table>
    </div>
</section>
