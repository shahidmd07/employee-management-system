<section class="panel narrow">
    <h2>Update Employee</h2>
    <div class="details">
        <div><small>Employee ID</small><b><%= employee.employee_id %></b></div>
        <div><small>Full Name</small><b><%= employee.full_name %></b></div>
        <div><small>Email</small><b><%= employee.email %></b></div>
        <div><small>Phone</small><b><%= employee.phone %></b></div>
    </div>
    <form class="stack" method="post" action="/admin/employees/<%= employee.employee_id %>/update">
        <label>Department
            <select name="departmentId" required>
                <% departments.forEach(item => { %>
                    <option value="<%= item.id %>" <%= item.name === employee.department ? 'selected' : '' %>><%= item.name %></option>
                <% }) %>
            </select>
        </label>
        <label>Designation
            <select name="designationId" required>
                <% designations.forEach(item => { %>
                    <option value="<%= item.id %>" <%= item.name === employee.designation ? 'selected' : '' %>><%= item.name %></option>
                <% }) %>
            </select>
        </label>
        <label>Salary<input type="number" name="salary" min="0" step="0.01" value="<%= employee.salary %>" required></label>
        <button type="submit">Save Changes</button>
    </form>
</section>
