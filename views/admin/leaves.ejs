<section class="panel">
    <h2>Leave Requests</h2>
    <div class="table-wrap">
        <table>
            <thead><tr>
                <th>Employee</th><th>Employee ID</th><th>Leave Type</th>
                <th>From</th><th>To</th><th>Reason</th><th>Status</th><th>Action</th>
            </tr></thead>
            <tbody>
                <% leaves.forEach(leave => { %>
                    <tr>
                        <td><%= leave.full_name %></td>
                        <td><%= leave.employee_id %></td>
                        <td><%= leave.leave_type %></td>
                        <td><%= leave.from_date %></td>
                        <td><%= leave.to_date %></td>
                        <td><%= leave.reason %></td>
                        <td class="<%= leave.status.toLowerCase() %>"><%= leave.status %></td>
                        <td>
                            <% if (leave.status === 'Pending') { %>
                                <form class="inline" method="post" action="/admin/leaves/<%= leave.id %>/approve"><button class="approve">Approve</button></form>
                                <form class="inline" method="post" action="/admin/leaves/<%= leave.id %>/decline"><button class="danger">Decline</button></form>
                            <% } else { %>—<% } %>
                        </td>
                    </tr>
                <% }) %>
                <% if (!leaves.length) { %><tr><td colspan="8">No leave requests found.</td></tr><% } %>
            </tbody>
        </table>
    </div>
</section>
